PROJECT_NAME=School Inventory API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://school_inventory:school_inventory@localhost:5432/school_inventory
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

POSTGRES_DB=school_inventory
POSTGRES_USER=school_inventory
POSTGRES_PASSWORD=school_inventory
